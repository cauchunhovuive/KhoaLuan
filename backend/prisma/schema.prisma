generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  PARTNER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANKING
  MOMO
  VNPAY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String
  name           String
  phone          String?
  avatar         String?
  address        String?
  isActive       Boolean   @default(true)
  role           UserRole  @default(CUSTOMER)
  refreshToken   String?
  clusterId      String?
  totalSpent     Float     @default(0)
  orderCount     Int       @default(0)
  lastPurchaseAt DateTime?

  // Partner fields
  storeName        String?  // Tên cửa hàng
  storeDescription String?  // Mô tả cửa hàng
  taxCode          String?  // Mã số thuế
  businessAddress  String?  // Địa chỉ kinh doanh
  isApproved       Boolean  @default(false)  // Admin phê duyệt
  approvedAt       DateTime?
  rejectedReason   String?  // Lý do từ chối (nếu có)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders          Order[]
  reviews         Review[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  cluster         Cluster?       @relation(fields: [clusterId], references: [id])
  recommendations Recommendation[]
  products        Product[]      @relation("PartnerProducts")
  couponsCreated  Coupon[]
  couponUsages    CouponUsage[]
  savedCoupons    SavedCoupon[]
  addresses        Address[]
  refunds          Refund[]
  auditLogs        AuditLog[]
  following        FollowedShop[]     @relation("UserFollows")
  followers        FollowedShop[]     @relation("PartnerFollowed")
  conversationsAsUser    Conversation[] @relation("UserConversations")
  conversationsAsPartner Conversation[] @relation("PartnerConversations")
  sentMessages    Message[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Product {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  price         Float
  discountPrice Float?
  images        String[]
  stock         Int      @default(0)
  soldCount     Int      @default(0)
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  isActive      Boolean  @default(true)
  categoryId    String
  partnerId     String?  // Người hợp tác kinh doanh đăng sản phẩm
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category    Category    @relation(fields: [categoryId], references: [id])
  partner     User?       @relation("PartnerProducts", fields: [partnerId], references: [id])
  orderItems  OrderItem[]
  reviews     Review[]
  cartItems   CartItem[]
  wishlistItems   WishlistItem[]
  recommendations Recommendation[]
  flashSaleProducts FlashSaleProduct[]
  variants          ProductVariant[]
  productViews      ProductView[]
}

model Order {
  id             String        @id @default(uuid())
  userId         String
  totalAmount    Float
  shippingFee    Float         @default(0)
  discountAmount Float         @default(0)
  finalAmount    Float
  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod @default(COD)
  paymentStatus  PaymentStatus @default(UNPAID)
  shippingAddress String
  phone          String
  note           String?
  couponId       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  orderItems  OrderItem[]
  coupon      Coupon?     @relation(fields: [couponId], references: [id])
  couponUsages CouponUsage[]
  refunds       Refund[]
  conversations Conversation[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model CartItem {
  id        String @id @default(uuid())
  userId    String
  productId String
  quantity  Int    @default(1)

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  reply     String?  // Phản hồi từ người bán/admin
  repliedAt DateTime?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Cluster {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  clusterRules ClusterRule[]
}

model ClusterRule {
  id             String   @id @default(uuid())
  clusterId      String
  metricName     String   // recency, frequency, monetary, age, gender
  minValue       Float?
  maxValue       Float?
  priority       Int      @default(0)
  createdAt      DateTime @default(now())

  cluster Cluster @relation(fields: [clusterId], references: [id])
}

model Recommendation {
  id             String   @id @default(uuid())
  userId         String?
  clusterId      String?
  productId      String
  score          Float    @default(0)
  reason         String?  // based_on_cluster, based_on_purchase, similar_product
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  product Product  @relation(fields: [productId], references: [id])
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  type           String    // PERCENTAGE | FIXED
  value          Float     // 10 = 10% or 50000 = 50K
  minOrderValue  Float?    // Minimum order value to apply
  maxDiscount    Float?    // Max discount for percentage type
  usageLimit     Int?      // Total usage limit
  usedCount      Int       @default(0)
  perUserLimit   Int       @default(1)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  description    String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy User          @relation(fields: [createdById], references: [id])
  orders    Order[]
  usage     CouponUsage[]
  savedBy   SavedCoupon[]
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  orderId   String?
  usedAt    DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@unique([couponId, userId, orderId])
}

model Notification {
  id          String   @id @default(uuid())
  type        String   // ORDER, SYSTEM
  title       String
  message     String?
  referenceId String?  // orderId, etc.
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // JSON string for complex values
  updatedAt DateTime @updatedAt
}

// ─── Address: Nhiều địa chỉ giao hàng cho User ───
model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String?  // Nhà, Cơ quan, v.v.
  fullName   String?
  phone      String?
  street     String
  ward       String?
  district   String?
  city       String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ─── Refund: Yêu cầu hoàn trả ───
model Refund {
  id            String   @id @default(uuid())
  orderId       String
  userId        String
  reason        String   // Lý do hoàn trả
  description   String?  // Mô tả chi tiết
  images        String[] // Ảnh minh chứng
  amount        Float    // Số tiền yêu cầu hoàn
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED, REFUNDED
  adminReply    String?  // Phản hồi từ Admin
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
}

// ─── AuditLog: Lịch sử hành động quan trọng ───
model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String   // CREATE, UPDATE, DELETE, APPROVE, BAN, etc.
  entity     String   // USER, PRODUCT, ORDER, COUPON, etc.
  entityId   String?
  details    String?  // JSON string with extra info
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── Banner: Banner trang chủ ───
model Banner {
  id          String   @id @default(uuid())
  title       String?
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  linkText    String?
  position    Int      @default(0)  // Thứ tự hiển thị
  isActive    Boolean  @default(true)
  bgColor     String?  // Màu nền (optional)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── FlashSale: Sự kiện Flash Sale ───
model FlashSale {
  id          String   @id @default(uuid())
  title       String
  description String?
  bannerUrl   String?
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products FlashSaleProduct[]
}

model FlashSaleProduct {
  id         String  @id @default(uuid())
  flashSaleId String
  productId  String
  salePrice  Float   // Giá flash sale
  maxQuantity Int     @default(0)  // Số lượng tối đa cho flash sale
  soldCount  Int     @default(0)

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([flashSaleId, productId])
}

// ─── SavedCoupon: Mã giảm giá user đã lưu ───
model SavedCoupon {
  id        String   @id @default(uuid())
  userId    String
  couponId  String
  savedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])

  @@unique([userId, couponId])
}

// ─── Violation: Vi phạm shop/sản phẩm ───
model Violation {
  id          String   @id @default(uuid())
  reportedById String  // Người báo cáo
  targetId    String   // ID shop (user) hoặc sản phẩm
  targetType  String   // SHOP, PRODUCT
  reason      String
  description String?
  evidence    String[] // Ảnh/video bằng chứng
  status      String   @default("PENDING") // PENDING, INVESTIGATING, RESOLVED, DISMISSED
  penalty     String?  // WARNING, SUSPEND, BAN
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── FollowedShop: Theo dõi shop ───
model FollowedShop {
  id        String   @id @default(uuid())
  userId    String   // User theo dõi
  partnerId String   // Shop được theo dõi
  createdAt DateTime @default(now())

  user    User @relation("UserFollows", fields: [userId], references: [id])
  partner User @relation("PartnerFollowed", fields: [partnerId], references: [id])

  @@unique([userId, partnerId])
}

// ─── ProductView: Lượt xem sản phẩm (cho Session-based Recommendations) ───
model ProductView {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([createdAt])
}

// ─── ProductVariant: Biến thể sản phẩm ───
model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  name      String  // VD: "Đỏ", "XL", "32GB"
  type      String  // color, size, storage, etc.
  price     Float?  // Giá riêng cho biến thể (nếu khác)
  stock     Int     @default(0)
  image     String? // Ảnh riêng cho biến thể
  sku       String? // Mã SKU

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, name, type])
}

// ─── Conversation & Message: Chat giữa User và Partner ───
model Conversation {
  id        String   @id @default(uuid())
  userId    String
  partnerId String
  orderId   String?  // Liên kết với đơn hàng (nếu có)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation("UserConversations", fields: [userId], references: [id])
  partner User     @relation("PartnerConversations", fields: [partnerId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id])
  messages Message[]

  @@unique([userId, partnerId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  images         String[]
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])
}
